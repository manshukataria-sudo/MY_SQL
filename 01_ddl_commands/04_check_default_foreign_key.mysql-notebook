    "content": "\\about\nUSE campusx;\nSELECT * FROM students\nDROP TABLE students\n-- CHECK constraint on column => allows values only of the conditions met else not\nCREATE TABLE students (\n    student_id INTEGER AUTO_INCREMENT,\n    name VARCHAR(255) NOT NULL,\n    age INTEGER,\n    CONSTRAINT students_pk PRIMARY KEY (student_id),\n    CONSTRAINT student_age_check CHECK (age > 6 AND age < 25)\n);\n\nINSERT INTO students (name, age)\nVALUES (\"manshu\", 21);\nSELECT * FROM students\n-- got error due to constraint, age was less than 6\nINSERT INTO students (name, age)\nVALUES (\"ansh\", 5);\n-- DEFAULT constraint => it sets the default value, if not provided by the user\n-- DATETIME data type to store both date and time and function CURRENT_TIMESTAMP returns, as name states\nCREATE TABLE ticket (\n    ticket_id INTEGER AUTO_INCREMENT,\n    name VARCHAR(255) NOT NULL,\n    date_of_travel DATETIME DEFAULT CURRENT_TIMESTAMP,\n    CONSTRAINT ticket_pk PRIMARY KEY (ticket_id)\n);\nINSERT INTO ticket (name)\nVALUES\n    (\"manshu\"),\n    (\"ansh\");\n\nSELECT * FROM ticket\n\n\n",
